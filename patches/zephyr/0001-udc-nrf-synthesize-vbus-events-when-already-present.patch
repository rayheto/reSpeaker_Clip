diff --git a/drivers/usb/udc/udc_nrf.c b/drivers/usb/udc/udc_nrf.c
index da0e5271b9e..0acbec75475 100644
--- a/drivers/usb/udc/udc_nrf.c
+++ b/drivers/usb/udc/udc_nrf.c
@@ -1763,6 +1763,23 @@ static int udc_nrf_init(const struct device *dev)
 	nrfx_power_usbevt_init(&cfg->evt);
 
 	nrfx_power_usbevt_enable();
+
+#ifdef CONFIG_HAS_HW_NRF_USBREG
+	/* USBREG power events are edge-triggered. If VBUS is already present at
+	 * init time (e.g. boot following a warm reset out of a USB-enabled
+	 * bootloader), no USBDETECTED/USBPWRRDY event will ever fire and USBD is
+	 * never started: the host sees a zombie connection that fails enumeration
+	 * ("device not accepting address"). Synthesize the missing events from the
+	 * current regulator status, like the legacy usb_dc_nrfx driver does.
+	 */
+	if (nrfx_power_usbstatus_get() != NRFX_POWER_USB_STATE_DISCONNECTED) {
+		udc_nrf_power_handler(NRFX_POWER_USB_EVT_DETECTED);
+		if (nrfx_power_usbstatus_get() == NRFX_POWER_USB_STATE_READY) {
+			udc_nrf_power_handler(NRFX_POWER_USB_EVT_READY);
+		}
+	}
+#endif
+
 	LOG_INF("Initialized");
 
 	return 0;
